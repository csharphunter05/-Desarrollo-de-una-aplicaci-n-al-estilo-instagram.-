<div class="container auth-page py-5">
  <section class="auth-card">
    <h1 class="h5 text-center mb-2">¿Problemas para iniciar sesión?</h1>
    <p class="text-secondary text-center mb-4">
      Escribe tu correo y te enviaremos instrucciones para recuperar tu cuenta.
    </p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name),
                 html: { method: :post }) do |form| %>
      <div class="mb-3">
        <%= form.label :email, "Correo electrónico", class: "form-label" %>
        <%= form.email_field :email, autofocus: true, autocomplete: "email",
                             class: "form-control", required: true %>
      </div>

      <%= form.submit "Enviar instrucciones", class: "btn btn-primary w-100" %>
    <% end %>

    <div class="auth-divider">o</div>
    <p class="text-center mb-0">
      <%= link_to "Volver a iniciar sesión", new_session_path(resource_name) %>
    </p>
  </section>
</div>
