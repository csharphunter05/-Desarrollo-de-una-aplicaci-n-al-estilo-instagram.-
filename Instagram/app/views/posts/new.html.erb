<div class="container form-page py-4">
  <div class="card form-card">
    <div class="card-body p-4">
      <h1 class="h3 mb-4">Nueva publicación</h1>

      <%= form_with model: @post do |form| %>
        <% if @post.errors.any? %>
          <div class="alert alert-danger" role="alert">
            <h2 class="h6">No se pudo guardar la publicación:</h2>
            <ul class="mb-0">
              <% @post.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-3">
          <%= form.label :image, "Imagen", class: "form-label" %>
          <%= form.file_field :image, class: "form-control", accept: "image/*", required: true %>
          <div class="form-text">Selecciona una imagen para compartir.</div>
        </div>

        <div class="mb-4">
          <%= form.label :description, "Descripción", class: "form-label" %>
          <%= form.text_area :description, class: "form-control", rows: 4,
                             minlength: 10, required: true,
                             placeholder: "Cuéntanos sobre este momento..." %>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <%= form.submit "Publicar", class: "btn btn-primary" %>
          <%= link_to "Cancelar", root_path, class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>

  <p class="mt-3 mb-0">
    <%= link_to "Volver al inicio", root_path, class: "link-secondary" %>
  </p>
</div>