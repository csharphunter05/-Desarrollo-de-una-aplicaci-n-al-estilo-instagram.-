<div class="container">
  <h1>Instagram</h1>

  <%= link_to "Nueva publicación", new_post_path %>

  <hr>

  <% @posts.each do |post| %>
    <div class="post">
      <h4><%= post.user.email %></h4>

      <% if post.image.attached? %>
        <%= image_tag post.image,
                      style: "max-width: 400px;" %>
      <% end %>

      <p><%= post.description %></p>

      <%= link_to "Ver publicación", post_path(post) %>

      <hr>
    </div>
  <% end %>
</div>
